# Runtime mode: "development" or "production" (production enables secure cookies and requires SESSION_SECRET)
ENV=development
# SQLAlchemy URL; SQLite locally, Supabase Postgres in prod (postgresql://user:pass@host:port/db)
DATABASE_URL=sqlite:///./local.db
# Secret used to sign session cookies; must be a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string
# Maximum upload size for imported files, in megabytes
MAX_UPLOAD_MB=5
# Create demo users on startup if they do not exist yet
SEED_ON_START=true
